# Copy to .env.local (local) or .env.production.local (server) and fill in.

# Amrod Vendor API (catalogue, prices, stock)
AMROD_API_URL=https://vendorapi.amrod.co.za
AMROD_USERNAME=
AMROD_PASSWORD=
AMROD_CUSTOMER_CODE=
# Optional override, defaults to https://identity.amrod.co.za/VendorLogin
# AMROD_LOGIN_URL=

# Public URL of the site. Must start with https:// in production so
# login cookies are marked Secure.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase storage (required on Vercel; leave empty to use .data/ files).
# Supabase -> Project Settings -> API: Project URL and the service_role
# (secret) key. NEVER put the service_role key in a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel cron calls /api/cron/catalogue with this (any long random string).
CRON_SECRET=

# Signs login cookies. 32+ random characters. REQUIRED on Vercel.
# Elsewhere, if empty, one is generated and kept in .data/.session-secret.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Prices are public by default. Set to true (and rebuild) to show them
# only to signed-in customers.
NEXT_PUBLIC_PRICES_REQUIRE_LOGIN=false

# Comma-separated emails that see every order and quote (Lénor staff).
# They must register on the site with these exact addresses.
ADMIN_EMAILS=larry@lenor.co.za,ronel@lenor.co.za

# Email (Lénor mail is hosted on cp66.domains.co.za).
#   Quote requests -> sales@, orders -> sales@ + accounts@, contact form -> info@.
# SMTP_USER is the mailbox the site signs in with and sends from; put its
# password in SMTP_PASSWORD (never commit it). Leave SMTP_HOST empty to
# switch email off (quotes and orders still save).
SMTP_HOST=cp66.domains.co.za
SMTP_PORT=465
SMTP_USER=info@lenor.co.za
SMTP_PASSWORD=
# Optional. Defaults to "Lénor Branding <SMTP_USER>".
MAIL_FROM=
# Optional overrides for where messages go (these are the defaults).
INFO_EMAIL=info@lenor.co.za
SALES_EMAIL=sales@lenor.co.za
ACCOUNTS_EMAIL=accounts@lenor.co.za
# Optional extra staff copied on every alert (comma separated).
NOTIFY_EMAILS=

# Incoming mail, for setting up the mailboxes in Outlook or a phone
# (not used by the site): cp66.domains.co.za, IMAP 993 (SSL), POP3 995 (SSL).

# PayFast (not used yet: payment is offline until the passphrase is set up)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
