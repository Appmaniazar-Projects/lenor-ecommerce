# Copy to .env.local (local) or .env.production.local (server) and fill in.

# Amrod Vendor API (catalogue, prices, stock)
AMROD_API_URL=https://vendorapi.amrod.co.za
AMROD_USERNAME=
AMROD_PASSWORD=
AMROD_CUSTOMER_CODE=
# Optional override, defaults to https://identity.amrod.co.za/VendorLogin
# AMROD_LOGIN_URL=

# Public URL of the site. Must start with https:// in production so
# login cookies are marked Secure.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs login cookies. 32+ random characters. If empty, one is generated
# and kept in .data/.session-secret.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Comma-separated emails that see every order and quote (Lenor staff).
ADMIN_EMAILS=

# PayFast (not used yet: payment is offline until the passphrase is set up)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
