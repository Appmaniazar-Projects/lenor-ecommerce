# Copy to .env.local (local) or .env.production.local (server) and fill in.

# Amrod Vendor API (catalogue, prices, stock)
AMROD_API_URL=https://vendorapi.amrod.co.za
AMROD_USERNAME=
AMROD_PASSWORD=
AMROD_CUSTOMER_CODE=
# Optional override, defaults to https://identity.amrod.co.za/VendorLogin
# AMROD_LOGIN_URL=

# Public URL of the site. Must start with https:// in production so
# login cookies are marked Secure.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs login cookies. 32+ random characters. If empty, one is generated
# and kept in .data/.session-secret.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Prices are public by default. Set to true (and rebuild) to show them
# only to signed-in customers.
NEXT_PUBLIC_PRICES_REQUIRE_LOGIN=false

# Comma-separated emails that see every order and quote (Lenor staff).
ADMIN_EMAILS=

# Email alerts for new quotes and orders (from the noreply mailbox).
# Get these from whoever hosts lenor.co.za email. Leave SMTP_HOST empty
# to switch email off (quotes and orders still save).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=noreply@lenor.co.za
SMTP_PASSWORD=
MAIL_FROM=Lenor <noreply@lenor.co.za>
# Staff who receive alerts (comma separated). Defaults to ADMIN_EMAILS.
NOTIFY_EMAILS=

# PayFast (not used yet: payment is offline until the passphrase is set up)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
