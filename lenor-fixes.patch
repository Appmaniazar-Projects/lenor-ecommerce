diff --git a/app/api/checkout/route.ts b/app/api/checkout/route.ts
new file mode 100644
index 0000000..f1433c3
--- /dev/null
+++ b/app/api/checkout/route.ts
@@ -0,0 +1,20 @@
+import { NextResponse } from "next/server"
+import { checkoutSchema, createOrder } from "@/lib/orders"
+import { errorResponse } from "@/lib/api-helpers"
+
+export async function POST(request: Request) {
+  try {
+    const input = checkoutSchema.parse(await request.json())
+    const order = await createOrder(input)
+
+    // The order is saved as Pending / unpaid. PayFast hooks in here next:
+    // build the signed payment redirect for `order`, and mark it paid from
+    // the ITN (notify) handler once PayFast confirms.
+    return NextResponse.json(
+      { success: true, orderId: order.id, orderNumber: order.orderNumber, total: order.total },
+      { status: 201 }
+    )
+  } catch (error) {
+    return errorResponse(error)
+  }
+}
