+import { NextResponse } from "next/server"
+import { createQuote, listQuotes, quoteSchema } from "@/lib/orders"
+import { errorResponse } from "@/lib/api-helpers"
+
+export async function POST(request: Request) {
+  try {
+    const quote = await createQuote(quoteSchema.parse(await request.json()))
+    return NextResponse.json(
+      { success: true, quoteId: quote.id, quoteNumber: quote.quoteNumber },
+      { status: 201 }
+    )
+  } catch (error) {
+    return errorResponse(error)
+  }
